# Copy this file to backend/.env and set your Groq API key
GROQ_API_KEY=your_groq_api_key_here

# Optional comma-separated list of allowed frontend origins for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Optional rate limiting configuration
RATE_LIMIT_BURST_PER_15S=5
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_HOUR=100
GLOBAL_RATE_LIMIT_PER_MINUTE=120
